diff --git a/FORK.md b/FORK.md
index 3d97ff87..0d8e9481 100644
--- a/FORK.md
+++ b/FORK.md
@@ -12,6 +12,7 @@ CodexCoder21 production depends on a set of jvm-libp2p fixes that are **not yet
 
 ## What this fork carries
 
+- **Owned transport shutdown after failed channel close** (snapshot-42) — TCP and WebSocket always terminate their private acceptor group after channel close settles, including failed listener or connection closes. QUIC does the same for its private worker group. The original channel failure remains the returned failure after cleanup, and caller cancellation/completion cannot stop cleanup. Public connection and Netty group/thread tests cover refused, thrown and delayed close results as well as caller mutation.
 
 On top of the upstream `develop` snapshot (which already provides the #412 thread-shutdown fix), this fork adds the following fixes. Each is meant to go upstream; nothing here is a long-term divergence.
 
diff --git a/README.md b/README.md
index 8a1a0208..a2bca048 100644
--- a/README.md
+++ b/README.md
@@ -351,6 +351,12 @@ fun retryConnectionClose(connection: Connection): CompletableFuture<Unit> =
 Other `Connection` implementations inherit a default that delegates to their `close()` operation.
 An implementation that retains failed close results must override `retryClose()` to support a new attempt.
 
+TCP, WebSocket and QUIC transport shutdown always waits for the event-loop groups owned by
+that transport to terminate, including when a listener or connection close fails. The returned
+future retains the original channel-close failure after cleanup. Cancelling or completing that
+future does not stop the owned cleanup. TCP and WebSocket leave their shared worker group running
+for other transports.
+
 ## Gossip simulator
 
 Deterministic Gossip simulator which may simulate networks as large as 10000 of peers
diff --git a/libp2p/src/main/kotlin/io/libp2p/transport/implementation/PlainNettyTransport.kt b/libp2p/src/main/kotlin/io/libp2p/transport/implementation/PlainNettyTransport.kt
index 75d16781..0a82518b 100644
--- a/libp2p/src/main/kotlin/io/libp2p/transport/implementation/PlainNettyTransport.kt
+++ b/libp2p/src/main/kotlin/io/libp2p/transport/implementation/PlainNettyTransport.kt
@@ -182,14 +182,15 @@ abstract class PlainNettyTransport(
         val everythingThatNeedsToClose = unbindsCompleted.union(channelsClosed)
         val allClosed = CompletableFuture.allOf(*everythingThatNeedsToClose.toTypedArray())
 
-        return allClosed.thenCompose {
+        // Cleanup observes every channel outcome independently of the caller's future.
+        val groupClosed = allClosed.handle { _, _ ->
             // Use an explicit quietPeriod = 0 instead of relying on Netty's default
             // (DefaultEventExecutor.DEFAULT_SHUTDOWN_QUIET_PERIOD = 2 SECONDS).
             //
             // The quiet period is the time `shutdownGracefully` keeps the event loop
             // alive AFTER its last task finished, in case more work is submitted. Once
-            // we have called close() on this transport every existing channel has been
-            // closed, the transport is marked closed (so listen()/dial() throw), and
+            // we have called close() on this transport every channel close attempt has
+            // settled, the transport is marked closed (so listen()/dial() throw), and
             // there is by construction no path that submits new work to either group.
             // Waiting 2 seconds for "more work that isn't coming" is pure latency.
             //
@@ -215,9 +216,14 @@ abstract class PlainNettyTransport(
             // single transport — a daemon group cannot hold the JVM open, so leaving it
             // running is safe, and shutting it down here would tear the worker loop out
             // from under every other live host in the JVM.
-            CompletableFuture.allOf(
-                bossGroup.shutdownGracefully(0, 5, TimeUnit.SECONDS).toVoidCompletableFuture()
-            ).thenApply { }
+            bossGroup.shutdownGracefully(0, 5, TimeUnit.SECONDS).toVoidCompletableFuture()
+        }.thenCompose { it }
+        return groupClosed.handle { _, shutdownFailure ->
+            // Cleanup starts after allClosed settles, so join cannot block here.
+            // Read that outcome first to preserve the original channel-close failure.
+            allClosed.join()
+            if (shutdownFailure != null) throw shutdownFailure
+            Unit
         }
     } // close
 
