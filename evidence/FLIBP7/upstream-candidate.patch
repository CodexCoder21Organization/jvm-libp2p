diff --git a/libp2p/src/test/kotlin/io/libp2p/transport/PlainNettyTransportFailedCloseSetTest.kt b/libp2p/src/test/kotlin/io/libp2p/transport/PlainNettyTransportFailedCloseSetTest.kt
