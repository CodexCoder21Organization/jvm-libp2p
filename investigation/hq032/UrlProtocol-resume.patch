+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicReference
+import kotlin.test.*
+
+fun testRawProviderGossipFlushReportsAcceptedWriteFailure() {
+    println("FLUSH_PROTOCOL_SOURCE=" + Libp2pHostFactory::class.java.protectionDomain.codeSource.location)
+    val server = Libp2pHostFactory.createServerHost(listOf("/ip4/127.0.0.1/tcp/0"),
+        object : RpcRequestHandler {
+            override suspend fun handleRequest(request: Libp2pRpcProtocol.RpcRequest, effectHandler: EffectPropagator) =
+                Libp2pRpcProtocol.RpcResponse.success(request.id, mapOf("ok" to true))
+        })
+    val client = Libp2pHostFactory.createHost(listenAddresses = emptyList())
+    val executor = Executors.newSingleThreadExecutor()
+    val accepted = CompletableFuture<Pair<Any, ChannelPromise>>()
+    val beforeFlush = CountDownLatch(1)
+    val releaseFlush = CountDownLatch(1)
+    val fault = IOException("The transport rejected the accepted gossip frame before flush")
+    var controller: Libp2pRpcController? = null
+    try {
+        server.start().get(10, TimeUnit.SECONDS)
+        client.start().get(10, TimeUnit.SECONDS)
+        val opened = client.newStream<Libp2pRpcController>(listOf(Libp2pRpcProtocol.PROTOCOL_ID),
+            server.peerId, *server.listenAddresses().toTypedArray())
+        val active = opened.controller.get(10, TimeUnit.SECONDS)
+        controller = active
+        val stream = opened.stream.get(10, TimeUnit.SECONDS)
+        stream.pushHandler(object : ChannelOutboundHandlerAdapter() {
+            override fun write(ctx: ChannelHandlerContext, message: Any, promise: ChannelPromise) {
+                check(accepted.complete(message to promise)) { "The codec must emit one complete frame" }
+            }
+        })
+        val channel = (stream as P2PChannelOverNetty).nettyChannel
+        channel.eventLoop().submit {}.get(10, TimeUnit.SECONDS)
+        val output = object : OutputStream() {
+            override fun write(value: Int) = active.output.write(value)
+            override fun write(bytes: ByteArray, offset: Int, length: Int) = active.output.write(bytes, offset, length)
+            override fun flush() {
+                beforeFlush.countDown()
+                check(releaseFlush.await(10, TimeUnit.SECONDS)) { "The transport failure must be released" }
+                active.output.flush()
+            }
+        }
+        val writer = executor.submit<Throwable?> {
+            runCatching { Libp2pRpcProtocol.writeMessage(output, JSONObject().put("frame", "withdrawal")) }.exceptionOrNull()
+        }
+        val (message, promise) = accepted.get(10, TimeUnit.SECONDS)
+        assertTrue(beforeFlush.await(10, TimeUnit.SECONDS), "The framed write must reach flush")
+        channel.eventLoop().submit {
+            ReferenceCountUtil.release(message)
+            promise.setFailure(fault)
+        }.get(10, TimeUnit.SECONDS)
+        releaseFlush.countDown()
+        val failure = writer.get(10, TimeUnit.SECONDS)
+        println("FLUSH_FAILURE=" + failure?.stackTraceToString())
+        assertNotNull(failure, "A framed provider write must report an accepted transport write failure at flush")
+        assertTrue(generateSequence(failure) { it.cause }.any { it === fault },
+            "The framed write must preserve the original transport failure: ${failure.stackTraceToString()}")
+    } finally {
+        releaseFlush.countDown()
+        accepted.getNow(null)?.let { (message, promise) ->
+            if (!promise.isDone) {
+                ReferenceCountUtil.release(message)
+                promise.tryFailure(IOException("The test is closing"))
+            }
+        }
+        executor.shutdownNow()
+        try {
+            controller?.close()
+        } catch (failure: IOException) {
+            // A controller may report the injected accepted-write failure again on close.
+            // Verify that exact failure so cleanup does not replace the flush assertion.
+            assertTrue(generateSequence(failure as Throwable) { it.cause }.any { it === fault },
+                "Closing the failed stream must preserve the injected transport failure: ${failure.stackTraceToString()}")
+        } finally {
+            try { client.stop().get(10, TimeUnit.SECONDS) } finally { server.stop().get(10, TimeUnit.SECONDS) }
+        }
+        assertTrue(executor.awaitTermination(10, TimeUnit.SECONDS), "The framed writer must stop")
+    }
+}
