+private class ResponderNoiseSetup(delayPublication: Boolean) {
+    private val registered = CountDownLatch(CONCURRENT_DIALERS)
+    private val publication = if (delayPublication) CompletableFuture<Unit>() else null
+
+    fun onConnection() {
+        registered.countDown()
+    }
+
+    fun protocol(): MultistreamProtocol = object : MultistreamProtocol {
+        override val version = MultistreamProtocolV1.version
+
+        override fun <T> createMultistream(bindings: List<ProtocolBinding<T>>): Multistream<T> {
+            val delegate = MultistreamProtocolV1.createMultistream(bindings)
+            return object : Multistream<T> {
+                override val bindings = delegate.bindings
+
+                override fun initChannel(ch: P2PChannel): CompletableFuture<T> =
+                    delegate.initChannel(ch).thenCompose { controller ->
+                        publication?.thenApplyAsync(
+                            { controller },
+                            (ch as ConnectionOverNetty).nettyChannel.eventLoop()
+                        ) ?: CompletableFuture.completedFuture(controller)
+                    }
+            }
+        }
+    }
+
+    fun awaitConnections(connectedBy: Long) {
+        release()
+        check(registered.await(maxOf(0, connectedBy - System.nanoTime()), TimeUnit.NANOSECONDS)) {
+            "Expected all $CONCURRENT_DIALERS responder connections within the connection budget, " +
+                "but ${registered.count} remain unpublished"
+        }
+    }
+
+    fun release() {
+        publication?.complete(Unit)
+    }
+}
+
+private class InlineNoiseSetup(private val queueCallbacks: Boolean = false) {
+    private val activeContexts = ArrayBlockingQueue<ChannelHandlerContext>(2)
+    private val loopDispatchers = ConcurrentHashMap<EventExecutor, EmptyQueueNoiseDispatcher>()
+
+    fun prepare(connection: ConnectionOverNetty) {
+        connection.nettyChannel.config().isAutoRead = false
+        connection.pushHandler(object : ChannelInboundHandlerAdapter() {
+            override fun channelActive(ctx: ChannelHandlerContext) {
+                check(activeContexts.offer(ctx)) { "More than two inline setup channels became active" }
+            }
+
+            override fun channelRead(ctx: ChannelHandlerContext, msg: Any) {
+                if (queueCallbacks) ctx.executor().execute { ctx.channel().isRegistered }
+                dispatch(ctx) {
+                    if (ctx.channel().isActive) ctx.fireChannelRead(msg) else ReferenceCountUtil.release(msg)
+                }
+            }
+
+            override fun channelReadComplete(ctx: ChannelHandlerContext) {
+                dispatch(ctx) { ctx.fireChannelReadComplete() }
+            }
+        })
+    }
+
+    fun releaseCurrentConnection() {
+        val contexts = List(2) {
+            requireNotNull(activeContexts.poll(5, TimeUnit.SECONDS)) {
+                "Both inline setup channels must become active within 5 seconds"
+            }
+        }
+        // Returning from the accept loop ensures its registration listener is attached.
+        contexts.forEach { ctx ->
+            ctx.channel().parent()?.eventLoop()?.submit {}?.get(5, TimeUnit.SECONDS)
+        }
+        contexts.forEach { ctx ->
+            val released = CompletableFuture<Unit>()
+            ctx.executor().execute {
+                dispatch(ctx) {
+                    ctx.fireChannelActive()
+                    ctx.channel().config().isAutoRead = true
+                    released.complete(Unit)
+                }
+            }
+            released.get(5, TimeUnit.SECONDS)
+        }
+    }
+
+    private fun dispatch(ctx: ChannelHandlerContext, action: () -> Unit) {
+        check(ctx.executor().inEventLoop())
+        loopDispatchers.computeIfAbsent(ctx.executor()) { EmptyQueueNoiseDispatcher(it) }.submit(action)
+    }
+}
+
+// One dispatcher per loop avoids two channels waiting for each other's queued dispatch.
+private class EmptyQueueNoiseDispatcher(private val executor: EventExecutor) {
+    private val events = java.util.ArrayDeque<() -> Unit>()
+    private var scheduled = false
+
+    fun submit(action: () -> Unit) {
+        events.addLast(action)
+        schedule()
+    }
+
+    private fun schedule() {
+        if (scheduled) return
+        scheduled = true
+        executor.execute {
+            scheduled = false
+            val loop = executor as SingleThreadEventExecutor
+            while (events.isNotEmpty() && loop.pendingTasks() == 0) {
+                events.removeFirst().invoke()
+            }
+            if (events.isNotEmpty()) schedule()
+        }
+    }
+}
