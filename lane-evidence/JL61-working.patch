+    connection.nettyChannel.pipeline().addLast(
+        ImmediateEventExecutor.INSTANCE,
+        "retry-close-control",
+        object : ChannelOutboundHandlerAdapter() {
+            override fun close(ctx: ChannelHandlerContext, promise: ChannelPromise) = action(ctx, promise)
+        }
+    )
